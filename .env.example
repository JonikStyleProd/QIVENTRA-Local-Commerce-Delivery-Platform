# QIVENTRA environment variables. Copy to .env.local before running the app.
# Both are optional: without them the demo stays fully local and uses its own logo files.

# Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API -> anon public key
# Never put the service_role key here or anywhere in the client: it bypasses Row Level Security.
VITE_SUPABASE_ANON_KEY=

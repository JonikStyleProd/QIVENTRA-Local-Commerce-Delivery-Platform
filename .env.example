# ==============================================================================
# QIVENTRA — Local Commerce & Delivery Platform
# Environment Variables Configuration
# Copy this file to .env.local or .env before running the application.
# ==============================================================================

# Server-Side / AI Integrations
GEMINI_API_KEY=
APP_URL=

# Supabase Public Integration (Client-Side)
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Public Anon Key: Supabase Dashboard -> Project Settings -> API -> anon public key
# NOTE: Never provide the secret service_role key to client-side applications!
VITE_SUPABASE_ANON_KEY=

